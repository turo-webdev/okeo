# Zernio (solo servidor - nunca usar prefijo PUBLIC_)
ZERNIO_API_KEY=
ZERNIO_WEBHOOK_SECRET=
OAUTH_STATE_SECRET=
QUEUE_INTERNAL_SECRET=

# Google Gemini IA (solo servidor)
GEMINI_API_KEY=
GEMINI_CHAT_MODEL=gemini-2.5-flash

# Stripe SaaS ($9 USD/canal/mes - solo servidor)
STRIPE_SECRET_KEY=
STRIPE_CHANNEL_PRICE_ID=
STRIPE_WEBHOOK_SECRET=
STRIPE_AUTOMATIC_TAX=false

# Correo transaccional (Resend - invitaciones de equipo, solo servidor)
RESEND_API_KEY=
EMAIL_FROM=Okeo <invitaciones@okeo.ai>

# Supabase (se configurarán al conectar la org Okeo)
PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Dominios duales en producción (dejar vacío en localhost y *.workers.dev)
PUBLIC_APP_ORIGIN=
PUBLIC_MARKETING_ORIGIN=

# Google Identity Services (Client ID público para login directo sin mostrar supabase.co)
PUBLIC_GOOGLE_CLIENT_ID=
