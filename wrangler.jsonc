{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "okeo",
	"main": "workers/entry.ts",
	"compatibility_date": "2025-11-01",
	"compatibility_flags": ["nodejs_compat"],
	"assets": {
		"binding": "ASSETS",
		"directory": ".svelte-kit/cloudflare"
	},
	"vars": {
		"PUBLIC_APP_ORIGIN": "https://app.okeo.ai",
		"PUBLIC_MARKETING_ORIGIN": "https://okeo.ai",
		"PUBLIC_GOOGLE_CLIENT_ID": "774426314949-c6q2fudr60t43k8stv3tf1q19t7e818k.apps.googleusercontent.com"
	},
	"routes": [
		{ "pattern": "app.okeo.ai", "custom_domain": true },
		{ "pattern": "okeo.ai", "custom_domain": true },
		{ "pattern": "www.okeo.ai", "custom_domain": true }
	],
	"queues": {
		"producers": [{ "binding": "AI_JOBS", "queue": "okeo-ai-jobs" }],
		"consumers": [{ "queue": "okeo-ai-jobs", "max_batch_size": 5, "max_retries": 3 }]
	},
	"triggers": {
		"crons": ["0 6 * * *"]
	},
	"observability": {
		"enabled": true
	}
}
